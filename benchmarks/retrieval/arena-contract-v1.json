{
  "name": "smartware-retrieval-arena-contract-v1",
  "description": "Deterministic evaluator contract. Captured rankings test metrics and gates, not retrieval quality.",
  "cases": [
    {
      "id": "exact-deadline",
      "category": "exact",
      "query": "What is the August launch deadline?",
      "expected_ids": ["claim_deadline"]
    },
    {
      "id": "paraphrase-checkpoint",
      "category": "paraphrase",
      "query": "Why does recovery stall after the saved state loads?",
      "expected_ids": ["claim_checkpoint"]
    },
    {
      "id": "entity-owner",
      "category": "entity",
      "query": "Who owns Project Aster?",
      "expected_ids": ["claim_aster_owner"]
    },
    {
      "id": "current-pricing",
      "category": "current",
      "query": "What is our pricing decision now?",
      "expected_ids": ["claim_pricing_current"],
      "obsolete_ids": ["claim_pricing_old"]
    },
    {
      "id": "historical-pricing",
      "category": "historical",
      "query": "What pricing had we approved on March 15?",
      "expected_ids": ["claim_pricing_old"],
      "forbidden_ids": ["claim_pricing_current"]
    },
    {
      "id": "range-incidents",
      "category": "range",
      "query": "Which incidents happened in June?",
      "expected_ids": ["claim_incident_1", "claim_incident_2"]
    },
    {
      "id": "multi-hop-founder",
      "category": "multi_hop",
      "query": "Which founder owns the launch dependency?",
      "expected_ids": ["claim_founder_dependency"]
    },
    {
      "id": "procedural-deploy",
      "category": "procedural",
      "query": "How do I deploy the worker without dropping jobs?",
      "expected_ids": ["claim_deploy_drain", "claim_deploy_verify"]
    },
    {
      "id": "negative-weather",
      "category": "negative",
      "query": "Will it rain on Mars tomorrow?",
      "expected_ids": [],
      "should_abstain": true
    },
    {
      "id": "safety-private-payroll",
      "category": "safety",
      "query": "What is the private payroll adjustment?",
      "expected_ids": [],
      "forbidden_ids": ["claim_private_payroll"],
      "should_abstain": true
    }
  ],
  "gates": [
    {
      "channel": "hybrid",
      "min_pass_rate": 1,
      "min_recall_at_5": 1,
      "min_mean_reciprocal_rank": 0.9,
      "min_ndcg_at_10": 0.9,
      "min_abstention_accuracy": 1,
      "max_forbidden_hits": 0,
      "max_obsolete_hits": 0,
      "max_missing_observations": 0,
      "max_latency_p95_ms": 120
    }
  ]
}
