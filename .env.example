# Copy to .env and fill in. Loaded by scripts/launch.sh.
# .env is in .gitignore — never committed.

# Required if you want LLM-assisted claim extraction.
# Without this, deterministic pattern-based extraction still works.
ANTHROPIC_API_KEY=

# Optional: override the data directory (defaults to ~/smartware-data)
# SMARTWARE_DATA_DIR=/Users/you/smartware-data
