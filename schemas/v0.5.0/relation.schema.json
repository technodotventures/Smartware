{
  "$id": "https://smartware.dev/schemas/v0.5.0/relation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Typed Temporal Relation",
  "description": "A canonical claim-to-claim edge. Candidate/model-only edges are derived artifacts and do not validate against this schema.",
  "type": "object",
  "required": [
    "relation_id",
    "kind",
    "target",
    "valid_at",
    "invalid_at",
    "provenance"
  ],
  "properties": {
    "relation_id": {
      "$ref": "common.schema.json#/$defs/RelationId"
    },
    "kind": {
      "$ref": "common.schema.json#/$defs/RelationKind"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/ClaimId",
      "description": "Target claim. Observation support provenance belongs in derived_from or provenance.observation_ids."
    },
    "valid_at": {
      "$ref": "common.schema.json#/$defs/Iso8601"
    },
    "invalid_at": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/Iso8601"
        },
        {
          "type": "null"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "origin"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "deterministic",
            "user"
          ]
        },
        "rule_id": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional discovery source retained after deterministic verification. origin=model is not canonical-admissible."
        },
        "asserted_in_source_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Server-stamped source version where the edge was first admitted; immutable on carry-forward."
        },
        "target_claim_version": {
          "type": "integer",
          "minimum": 1,
          "description": "Pinned target assertion-version judged by this edge."
        },
        "observation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/ObservationId"
          }
        },
        "source_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 0
              },
              "text": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "origin": {
                "const": "deterministic"
              }
            },
            "required": [
              "origin"
            ]
          },
          "then": {
            "properties": {
              "rule_id": true,
              "asserted_in_source_version": true,
              "target_claim_version": true,
              "observation_ids": true
            },
            "required": [
              "rule_id",
              "asserted_in_source_version",
              "target_claim_version",
              "observation_ids"
            ]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "references"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "description": "A canonical reference is either deterministically verified or written by the user."
      },
      "else": {
        "properties": {
          "provenance": {
            "type": "object",
            "properties": {
              "origin": {
                "const": "user"
              },
              "asserted_in_source_version": true,
              "target_claim_version": true,
              "observation_ids": true
            },
            "required": [
              "asserted_in_source_version",
              "target_claim_version",
              "observation_ids"
            ]
          }
        },
        "description": "The six epistemic relation kinds are user-admitted only in v0.4.2 beta."
      }
    }
  ],
  "additionalProperties": false
}
